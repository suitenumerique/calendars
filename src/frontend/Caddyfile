{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	header X-Frame-Options DENY

	route {
		# SPA fallback: any unmatched request returns index.html so the
		# client-side router can resolve the path.
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		@spa_404 expression `{err.status_code} == 404`
		handle @spa_404 {
			rewrite * /index.html
			file_server
		}
	}
}
